    <DTS:Executable
      DTS:refId="Package\Merge Customer Delta"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{339842EC-DB72-456A-A038-9D8ED95EF7E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge Customer Delta"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E9A3EB8-6E84-4CF8-85CF-A5E6C1838666}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Update customers that already exist in staging.&#xA;    UPDATE target&#xA;    SET&#xA;        target.CustomerName = source.CustomerName,&#xA;        target.Gender = source.Gender,&#xA;        target.Age = source.Age,&#xA;        target.State = source.State,&#xA;        target.Segment = source.Segment,&#xA;        target.AcquisitionChannel = source.AcquisitionChannel,&#xA;        target.SignupDate = source.SignupDate,&#xA;        target.Status = source.Status,&#xA;        target.City = source.City,&#xA;        target.Region = source.Region,&#xA;        target.Email = source.Email,&#xA;        target.Phone = source.Phone,&#xA;        target.LastActivityDate = source.LastActivityDate,&#xA;        target.SourceLastModifiedDate =&#xA;            source.SourceLastModifiedDate,&#xA;        target.LoadDateTime = SYSDATETIME(),&#xA;        target.BatchID = source.BatchID&#xA;    FROM stg.Customer AS target&#xA;    INNER JOIN&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY CustomerID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.CustomerDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;        ON target.CustomerID = source.CustomerID;&#xA;&#xA;    -- Insert customers that do not exist in staging.&#xA;    INSERT INTO stg.Customer&#xA;    (&#xA;        CustomerID,&#xA;        CustomerName,&#xA;        Gender,&#xA;        Age,&#xA;        State,&#xA;        Segment,&#xA;        AcquisitionChannel,&#xA;        SignupDate,&#xA;        Status,&#xA;        City,&#xA;        Region,&#xA;        Email,&#xA;        Phone,&#xA;        LastActivityDate,&#xA;        SourceLastModifiedDate,&#xA;        LoadDateTime,&#xA;        BatchID&#xA;    )&#xA;    SELECT&#xA;        source.CustomerID,&#xA;        source.CustomerName,&#xA;        source.Gender,&#xA;        source.Age,&#xA;        source.State,&#xA;        source.Segment,&#xA;        source.AcquisitionChannel,&#xA;        source.SignupDate,&#xA;        source.Status,&#xA;        source.City,&#xA;        source.Region,&#xA;        source.Email,&#xA;        source.Phone,&#xA;        source.LastActivityDate,&#xA;        source.SourceLastModifiedDate,&#xA;        SYSDATETIME(),&#xA;        source.BatchID&#xA;    FROM&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY CustomerID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.CustomerDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM stg.Customer AS target&#xA;        WHERE target.CustomerID = source.CustomerID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Merge Employee Data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{251468DD-1E82-494C-AEF4-E4F50240D154}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge Employee Data"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E9A3EB8-6E84-4CF8-85CF-A5E6C1838666}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Update employees already in staging.&#xA;    UPDATE target&#xA;    SET&#xA;        target.EmployeeName = source.EmployeeName,&#xA;        target.Role = source.Role,&#xA;        target.Department = source.Department,&#xA;        target.StoreID = source.StoreID,&#xA;        target.HireDate = source.HireDate,&#xA;        target.Status = source.Status,&#xA;        target.SourceLastModifiedDate =&#xA;            source.SourceLastModifiedDate,&#xA;        target.LoadDateTime = SYSDATETIME(),&#xA;        target.BatchID = source.BatchID&#xA;    FROM stg.Employee AS target&#xA;    INNER JOIN&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY EmployeeID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.EmployeeDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;        ON target.EmployeeID = source.EmployeeID;&#xA;&#xA;    -- Insert employees not yet in staging.&#xA;    INSERT INTO stg.Employee&#xA;    (&#xA;        EmployeeID,&#xA;        EmployeeName,&#xA;        Role,&#xA;        Department,&#xA;        StoreID,&#xA;        HireDate,&#xA;        Status,&#xA;        SourceLastModifiedDate,&#xA;        LoadDateTime,&#xA;        BatchID&#xA;    )&#xA;    SELECT&#xA;        source.EmployeeID,&#xA;        source.EmployeeName,&#xA;        source.Role,&#xA;        source.Department,&#xA;        source.StoreID,&#xA;        source.HireDate,&#xA;        source.Status,&#xA;        source.SourceLastModifiedDate,&#xA;        SYSDATETIME(),&#xA;        source.BatchID&#xA;    FROM&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY EmployeeID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.EmployeeDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM stg.Employee AS target&#xA;        WHERE target.EmployeeID = source.EmployeeID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Merge Product Delta"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CA64FBCF-E63B-492D-89AB-627E61163FB9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge Product Delta"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E9A3EB8-6E84-4CF8-85CF-A5E6C1838666}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Update products that already exist in staging.&#xA;    UPDATE target&#xA;    SET&#xA;        target.ProductName = source.ProductName,&#xA;        target.Brand = source.Brand,&#xA;        target.Category = source.Category,&#xA;        target.SubCategory = source.SubCategory,&#xA;        target.UnitPrice = source.UnitPrice,&#xA;        target.UnitCost = source.UnitCost,&#xA;        target.Status = source.Status,&#xA;        target.SourceLastModifiedDate =&#xA;            source.SourceLastModifiedDate,&#xA;        target.LoadDateTime = SYSDATETIME(),&#xA;        target.BatchID = source.BatchID&#xA;    FROM stg.Product AS target&#xA;    INNER JOIN&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY ProductID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.ProductDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;        ON target.ProductID = source.ProductID;&#xA;&#xA;    -- Insert products that do not exist in staging.&#xA;    INSERT INTO stg.Product&#xA;    (&#xA;        ProductID,&#xA;        ProductName,&#xA;        Brand,&#xA;        Category,&#xA;        SubCategory,&#xA;        UnitPrice,&#xA;        UnitCost,&#xA;        Status,&#xA;        SourceLastModifiedDate,&#xA;        LoadDateTime,&#xA;        BatchID&#xA;    )&#xA;    SELECT&#xA;        source.ProductID,&#xA;        source.ProductName,&#xA;        source.Brand,&#xA;        source.Category,&#xA;        source.SubCategory,&#xA;        source.UnitPrice,&#xA;        source.UnitCost,&#xA;        source.Status,&#xA;        source.SourceLastModifiedDate,&#xA;        SYSDATETIME(),&#xA;        source.BatchID&#xA;    FROM&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY ProductID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.ProductDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM stg.Product AS target&#xA;        WHERE target.ProductID = source.ProductID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
