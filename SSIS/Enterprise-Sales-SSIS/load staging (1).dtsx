    <DTS:Executable
      DTS:refId="Package\Merge Store Delta"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5B049F38-6C3A-4346-82C9-1AFC00FDD741}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge Store Delta"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="7">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E9A3EB8-6E84-4CF8-85CF-A5E6C1838666}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Update stores already in staging.&#xA;    UPDATE target&#xA;    SET&#xA;        target.StoreName = source.StoreName,&#xA;        target.City = source.City,&#xA;        target.State = source.State,&#xA;        target.Region = source.Region,&#xA;        target.StoreType = source.StoreType,&#xA;        target.Status = source.Status,&#xA;        target.SourceLastModifiedDate =&#xA;            source.SourceLastModifiedDate,&#xA;        target.LoadDateTime = SYSDATETIME(),&#xA;        target.BatchID = source.BatchID&#xA;    FROM stg.Store AS target&#xA;    INNER JOIN&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY StoreID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.StoreDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;        ON target.StoreID = source.StoreID;&#xA;&#xA;    -- Insert stores not yet in staging.&#xA;    INSERT INTO stg.Store&#xA;    (&#xA;        StoreID,&#xA;        StoreName,&#xA;        City,&#xA;        State,&#xA;        Region,&#xA;        StoreType,&#xA;        Status,&#xA;        SourceLastModifiedDate,&#xA;        LoadDateTime,&#xA;        BatchID&#xA;    )&#xA;    SELECT&#xA;        source.StoreID,&#xA;        source.StoreName,&#xA;        source.City,&#xA;        source.State,&#xA;        source.Region,&#xA;        source.StoreType,&#xA;        source.Status,&#xA;        source.SourceLastModifiedDate,&#xA;        SYSDATETIME(),&#xA;        source.BatchID&#xA;    FROM&#xA;    (&#xA;        SELECT *&#xA;        FROM&#xA;        (&#xA;            SELECT&#xA;                *,&#xA;                ROW_NUMBER() OVER&#xA;                (&#xA;                    PARTITION BY StoreID&#xA;                    ORDER BY&#xA;                        SourceLastModifiedDate DESC,&#xA;                        LoadDateTime DESC&#xA;                ) AS RowNum&#xA;            FROM stg.StoreDelta&#xA;        ) AS ranked&#xA;        WHERE RowNum = 1&#xA;    ) AS source&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM stg.Store AS target&#xA;        WHERE target.StoreID = source.StoreID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
